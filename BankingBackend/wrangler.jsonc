{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mi-bombo-banking",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	"send_metrics": false,
	// Only the structured lines of the code (fixed categories and counts, never amounts, concepts, IDs or tokens).
	// The automatic log of each request is off: it would store the full URL, which on the bank's return carries
	// the authorization code.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"PROVIDER_MODE": "sandbox",
		"PUBLIC_ORIGIN": "https://mi-bombo-banking.albertor7722.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mi-bombo-banking",
			"database_id": "e38407f3-5256-4a74-aaf7-21fb1aeb67b8",
			"migrations_dir": "migrations"
		}
	]
}
